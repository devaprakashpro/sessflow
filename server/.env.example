# Sessflow Mesh server config — copy to .env (or export in your shell / systemd unit)

# Port to listen on
SESSFLOW_PORT=7777

# Bind address:
#   0.0.0.0     = all interfaces (LAN + tailnet)
#   tailscale   = auto-detect & bind ONLY this node's Tailscale IP (private to your tailnet) ← recommended
#   100.x.y.z   = bind a specific address
SESSFLOW_HOST=tailscale

# SQLite database path (sessions + archived pages). Auto-created.
SESSFLOW_DB=./data/sessflow.db

# Device token the extension must send. If unset, a random one is generated
# and written to ./data/.sessflow-token (and printed on first start).
# SESSFLOW_TOKEN=change-me

# Optional: enables /v1/ask (ask-your-tabs RAG). Key stays on the server.
# ANTHROPIC_API_KEY=sk-ant-...
SESSFLOW_AI_MODEL=claude-opus-4-8
